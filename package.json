{
  "name": "thundervox-web",
  "version": "0.0.0-dev",
  "private": true,
  "license": "BUSL-1.1",
  "description": "Operator console of the ThunderVox SIP endpoint platform",
  "repository": "github:beiroun/thundervox-web",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "update-types": "npx -y -p typescript@5 -p openapi-typescript@7 openapi-typescript ${TVX_OPENAPI_URL:-http://127.0.0.1:8080/api/v1/openapi} -o src/api/generated/openapi.ts"
  },
  "dependencies": {
    "@mantine/core": "9.6.3",
    "@mantine/hooks": "9.6.3",
    "@reduxjs/toolkit": "2.13.0",
    "@tabler/icons-react": "3.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-redux": "9.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "postcss": "8.5.28",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
